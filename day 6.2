import java.util.*;
public class lyy
 {
    public static void main(String[] args)
     {
        int arr[]={1,2,3,4,5,6};
        System.out.println("even numbers are:");
        for(int i=0;i<arr.length;i++)
         {
            if(arr[i]%2==0)
             {
                System.out.println(i+"");
             }
             System.out.println("odd numbers are:");
             for(int j=0;j<arr.length;j++)
         {
            if(arr[j]%2!=0)
             {
                System.out.println(j+"");
             }
         }
        
    }
} 
 }

import java.util.*;
public class lyy
 {
    public static void main(String[] args)
     {
              String s = "Hello World";

        int vowels = 0;
        int consonants = 0;

        s = s.toLowerCase();                    // A and a rendum same ah treat panna

        for (int i = 0; i < s.length(); i++) {
            char ch = s.charAt(i);

            if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u') {
                vowels++;
            } else if (ch >= 'a' && ch <= 'z') {  // letter ah irundhu vowel illa na
                consonants++;
            }
        }

        System.out.println("Vowels = " + vowels);
        System.out.println("Consonants = " + consonants);

      
 }}

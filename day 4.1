import java.util.Scanner;

public class lyy
{
    public static void main(String[] args) 
    {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int sum=0;
        int z=0;
        for(int i=0;i<=n;i++)
        {
            if(i%2==0)
            {
                sum=sum+i;
            }

            else{
                z=z+i;
            }
    
        }
          System.out.println("even :"+sum);
          System.out.println("odd :"+z);
    }
}

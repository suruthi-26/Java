public class Main {
    public static void main(String[] args) {
      //logical
         //and
         int age=18;
         boolean check=age>=18&&age<=20;
         System.out.println(check);//t
         //or
         boolean chk=age>=18||age<=20;
         System.out.println(chk);//t
         //not
         System.out.println(!(age > 17));// false (reverses true)
         
     //assignment
        int a = 10;            // simple assignment

        a += 5;                // a = a + 5
        System.out.println(a); // 15

        a -= 3;                // a = a - 3
        System.out.println(a); // 12

        a *= 2;                // a = a * 2
        System.out.println(a); // 24

        a /= 4;                // a = a / 4
        System.out.println(a); // 6

        a %= 4;                // a = a % 4
        System.out.println(a); // 2


     

    }
}

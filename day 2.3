public class Main {
    public static void main(String[] args) {
        int a = 5, b = 3;

        System.out.println("a & b = " + (a & b));   // AND 1
        System.out.println("a | b = " + (a | b));   // OR 7
        System.out.println("a ^ b = " + (a ^ b));   // XOR 6
        System.out.println("~a    = " + (~a));      // NOT -(5+1)
        System.out.println("~b    = " + (~b));      // NOT -(3+1)
    }
}

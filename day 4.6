import java.util.Scanner;

public class lyy {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter max stars (odd number): ");
        int max = sc.nextInt();

        int n = (max + 1) / 2;   // upper half la ethana rows (5 na 3 rows)

        // upper half: 1, 3, 5 ...
        for (int i = 1; i <= n; i++) {
            for (int s = 1; s <= n - i; s++) {      // spaces
                System.out.print(" ");
            }
            for (int j = 1; j <= 2 * i - 1; j++) {  // stars
                System.out.print("*");
            }
            System.out.println();
        }

        // lower half: ..., 3, 1
        for (int i = n - 1; i >= 1; i--) {
            for (int s = 1; s <= n - i; s++) {      // spaces
                System.out.print(" ");
            }
            for (int j = 1; j <= 2 * i - 1; j++) {  // stars
                System.out.print("*");
            }
            System.out.println();
        }

        sc.close();
    }
}

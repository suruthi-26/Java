import java.util.Scanner;

public class lyy
{
    public static void main(String[] args) 
    {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int sum=0;
        int z=0;
        for(int i=0;i<=n;i++)
        {
            if(i%3==0)
            {
                sum=sum+i;
            }

            else{
                z=z+i;
            }
    
        }
          System.out.println("multiple of 3 :"+sum);
        System.out.println("not multiple of 3 :"+z);
        
    }
}

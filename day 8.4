class Student {
    
    String name;
    int age;
    String dept;
}

public class Main {
    public static void main(String[] args) {
        Student s1 = new Student();       
        s1.name = "Suruthi";
        s1.age = 19;
        s1.dept = "CSE";

        Student s2 = new Student();       
        s2.name = "Homesh";
        s2.age = 19;
        s2.dept = "ECE";

        System.out.println(s1.name + " " + s1.age + " " + s1.dept);
        System.out.println(s2.name + " " + s2.age + " " + s2.dept);
    }
}

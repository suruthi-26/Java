public class Main {
    public static void main(String[] args) {
        int a = 5;
        int b = 20;
        int c = -16;

        // Left shift
        System.out.println("5 << 1  = " + (a << 1));    // 10
        System.out.println("5 << 2  = " + (a << 2));    // 20
        System.out.println("5 << 3  = " + (a << 3));    // 40

        // Right shift
        System.out.println("20 >> 1 = " + (b >> 1));    // 10
        System.out.println("20 >> 2 = " + (b >> 2));    // 5

        // Negative number
        System.out.println("-16 >> 2  = " + (c >> 2));  // -4
        System.out.println("-16 >>> 28 = " + (c >>> 28)); // 15

        // Binary view
        System.out.println(Integer.toBinaryString(a));        // 101
        System.out.println(Integer.toBinaryString(a << 2));   // 10100
    }
}

import java.util.*;
public class lyy
 {
    public static void main(String[] args)
     {
        int arr[]={6,1,0,2,9,5,6,3,7,4};
        int k=1;
        while (true) {
            boolean found = false;

            for (int i = 0; i < arr.length; i++)
           {
                if (arr[i] == k)
                    
                {          
                    found = true;
                    break;
                }
            }

            if (!found) {                   
                break;
            }
            k++;                           
        }

        System.out.println(k);
      }
} 
